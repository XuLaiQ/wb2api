# WorkBuddy 一体化部署 —— 环境变量示例
#
# 复制为 .env 再按需修改：cp .env.example .env
#
# ┌─ 先读这段：绝大多数项**留空即可** ───────────────────────────┐
# │ 合并成一个仓库后，上游就在本仓库的 ./upstream，代码会自己推导  │
# │ 出绝对路径（见 manager/server/config.py 的 _default_upstream_dir）。│
# │ 所以下面凡是带「留空 = 自动」注释的，都别填 —— 填了反而会把     │
# │ 推导结果覆盖掉，一旦写错（相对路径、盘符大小写）就是「0 个账号」│
# │ 这类难查的症状。                                              │
# └───────────────────────────────────────────────────────────┘
#
# 两种部署方式对这个文件的用法不同：
#   · Docker Compose（推荐）：compose 的 environment 已经设好了路径与上游地址，
#     .env 通常只需要放 WB_ADMIN_PASSWORD。下面的路径项一律留空。
#   · 原生进程（Windows / 宿主机直接跑）：需要按你的实际路径填 WB_UPSTREAM_DIR
#     等项；若仓库结构没动过，同样可以留空让代码推导。

# ── 本服务 ──────────────────────────────────────────────
WB_MANAGER_HOST=127.0.0.1
WB_MANAGER_PORT=7864
# auto = 依据 X-Forwarded-Proto 自动判断；生产走 HTTPS 时保持 auto 或设为 true。
# 反代若未透传该头，auto 会静默地不加 Secure（登录日志里有告警）——确定只走
# HTTPS 时建议直接写 true，不必依赖反代是否传头。
WB_SECURE_COOKIE=auto
# 会话总时长上限（天）：登录后最多维持这么久，到点必须重新登录。
WB_SESSION_DAYS=1
# 会话空闲上限（小时）：多久没操作就失效（**滑动续期**窗口）。常用的人会自动
# 续期、不被打扰；放着不用的会话到点自己过期。**0 = 关闭空闲判定**，只按上面的
# 总时长失效。
WB_SESSION_IDLE_HOURS=12
# 允许跨域来源（同源部署留空）
WB_CORS_ORIGINS=

# ── 上游 workbuddy2api（Go 反代）────────────────────────
# Docker Compose：填 http://workbuddy2api:7863（同一网络用服务名）
# 原生进程：     填 http://127.0.0.1:7863
WB2API_BASE=http://127.0.0.1:7863
# 留空则自动读取上游 config.json 里的 api_key
WB2API_KEY=
# docker（默认）= 通过 docker.sock 操作上游容器
# native        = 调 WB2API_START_SCRIPT / WB2API_STOP_SCRIPT 启停本机进程
WB2API_MODE=docker
# 容器名。**必须与 compose 里的 container_name 一致**，
# 因为「重启上游」走的是 `docker restart <这个名字>`。
WB2API_CONTAINER=workbuddy2api

# ── 上游数据文件（与 upstream/ 共享）────────────────────
# 留空 = 自动推导为 <仓库>/upstream（Docker 内为挂载点 /opt/workbuddy2api）。
#
# 为什么改成「留空优先」：原管理端要求这里填绝对路径，是它**唯一**的部署坑 ——
# 两个仓库分处不同目录时无法推导，只能让用户手写；路径一错就表现为
# 「面板显示 0 个账号」，而报错信息里既没有路径也没有原因。
# 合并后上游位置是确定的，推导比手写可靠。
#
# WB_UPSTREAM_DIR=
# WB_AUTH_DIR=              # 留空 = <upstream>/auths
# WB_UPSTREAM_CONFIG=       # 留空 = <upstream>/config.json
# WB2API_LOG_FILE=          # 留空 = <upstream>/data/server.err.log
# native 模式使用；Windows 路径写成 C:/path/to/file.cmd 这种正斜杠形式
# WB2API_START_SCRIPT=      # 留空 = <upstream>/start-workbuddy2api.cmd
# WB2API_STOP_SCRIPT=       # 留空 = <upstream>/stop-workbuddy2api.cmd

# ── 本管理端数据 ────────────────────────────────────────
# 留空 = <仓库>/manager/data 与 <仓库>/manager/web/out
# WB_DATA_DIR=
# WB_DB=
# WB_USERS_FILE=
# WB_STATIC_DIR=

# ── 初始管理员（仅首次启动生效）─────────────────────────
# 留空则随机生成并打印到日志（用户名固定为 admin）
WB_ADMIN_PASSWORD=

# ── 网络 ────────────────────────────────────────────────
WB_UPSTREAM_TIMEOUT=120
WB_TENCENT_TIMEOUT=15
WB_TRUST_PROXY=1
# 出口代理（可选）。留空 = 所有请求都不走代理。
# 注意：若服务器上装有代理软件（Clash 等 TUN 模式），务必保持留空，
# 否则连本机 workbuddy2api(127.0.0.1:7863) 的请求也可能被代理劫持而超时。
WB_HTTP_PROXY=
